-- ----------------------------
-- Table structure for t_department
-- ----------------------------
DROP TABLE IF EXISTS `t_department`;
CREATE TABLE `t_department`  (
  `id` int(10) NOT NULL AUTO_INCREMENT,
  `name` varchar(50) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL,
  `description` varchar(255) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL,
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 10007 CHARACTER SET = utf8 COLLATE = utf8_general_ci ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of t_department
-- ----------------------------
INSERT INTO `t_department` VALUES (10001, '财务部', '财务部是指在本机构一定的整体目标下，关于资产的购置（投资），资本的融通（筹资）和经营中现金流量（营运资金），以及利润分配的管理的部门。');
INSERT INTO `t_department` VALUES (10002, '行政部', '行政部门是组织或企业中负责管理和支持日常行政事务的部门。');
INSERT INTO `t_department` VALUES (10003, '销售部', '销售部门是组织内负责销售和市场推广活动的部门。其主要职责是促进产品或服务的销售，实现组织的销售目标和利润增长。销售部门通常与市场部门密切协作，共同制定销售策略和营销计划。');
INSERT INTO `t_department` VALUES (10004, '技术部', '技术部门是一个组织内负责技术开发、技术支持和技术管理的部门。其主要职责是提供技术解决方案，支持组织的技术需求，并确保技术的有效运作和发展。');
INSERT INTO `t_department` VALUES (10005, '后勤服务部', '后勤部是为其它各部门职能能够顺利实现提供物质服务的一个部门');

-- ----------------------------
-- Table structure for t_employee
-- ----------------------------
DROP TABLE IF EXISTS `t_employee`;
CREATE TABLE `t_employee`  (
  `id` int(10) NOT NULL AUTO_INCREMENT,
  `name` varchar(30) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL,
  `sex` char(2) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL,
  `age` int(5) NULL DEFAULT NULL,
  `position` varchar(30) CHARACTER SET utf8 COLLATE utf8_general_ci NULL DEFAULT NULL,
  `d_id` int(10) NULL DEFAULT NULL,
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 10052 CHARACTER SET = utf8 COLLATE = utf8_general_ci ROW_FORMAT = DYNAMIC;

