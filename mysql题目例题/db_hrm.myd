-- ----------------------------
-- View structure for v_hrm
-- ----------------------------
DROP VIEW IF EXISTS `v_hrm`;
CREATE ALGORITHM = UNDEFINED SQL SECURITY DEFINER VIEW `v_hrm` AS select `d`.`name` AS `部门名称`,`e`.`name` AS `员工姓名`,`e`.`sex` AS `性别`,`e`.`age` AS `年龄`,`e`.`position` AS `职位` from (`t_employee` `e` join `t_department` `d` on((`e`.`d_id` = `d`.`id`))) order by `d`.`name`;

-- ----------------------------
-- Procedure structure for calculate_total_salary
-- ----------------------------
DROP PROCEDURE IF EXISTS `calculate_total_salary`;
delimiter ;;
CREATE PROCEDURE `calculate_total_salary`(IN `emp_id` int,OUT `total_salary` double)
BEGIN
	SELECT SUM(money) INTO total_salary
    FROM t_salary
    WHERE e_id = emp_id;
END
;;
delimiter ;

-- ----------------------------
-- Triggers structure for table t_employee
-- ----------------------------
DROP TRIGGER IF EXISTS `update_department_description`;
delimiter ;;
CREATE TRIGGER `update_department_description` BEFORE INSERT ON `t_employee` FOR EACH ROW BEGIN
    IF NEW.d_id IS NOT NULL THEN
        UPDATE t_department
        SET description = '部门描述待更新'
        WHERE id = NEW.d_id AND description IS NULL;
    END IF;
END
;;
delimiter ;

SET FOREIGN_KEY_CHECKS = 1;
