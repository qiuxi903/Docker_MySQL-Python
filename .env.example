# ========= 复制为 .env 后按需修改（docker compose 会自动读取）=========

# 网站对外端口（学生直连时用的端口）
WEB_PORT=8000

# MySQL root 密码（仅容器内部使用，请修改）
MYSQL_ROOT_PASSWORD=change-me-root

# 管理员账号（登录网站后可管理用户）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 沙箱服务内部令牌（随机字符串即可，请修改）
RUNNER_TOKEN=change-me-runner-token

# Python 版本：3.12 或 3.14
PYTHON_VERSION=3.12

# 基础镜像源（国内拉不动 docker.io 时取消注释）：
# PYTHON_IMAGE=docker.m.daocloud.io/library/python
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:5.7

# ---------- 真实 IP（管理后台显示学生 IP、限流按真实 IP 统计）----------
# 1    = 信任反代头（宝塔/Nginx 反代后面用这个）
# 0    = 只认直连来源，不信任 X-Forwarded-For（防止伪造头部刷限流）
# 不设 = auto：有反代头就用，没有就用直连来源
# 排查：管理后台「总览 → 网络诊断」会显示这次请求收到的头与最终判定
TRUST_PROXY=1

# 内置真实 IP 反代的端口（docker compose --profile realip up -d 时生效）
# 学生改从该端口访问即可拿到真实 IP；宿主机 80 被宝塔占用时改成别的，如 8080
# PROXY_PORT=80

# ---------- 业务参数（一般不用改）----------
# Python 文件总容量默认配额（MB）：新用户默认值，-1=无限；管理员永远无限。
# 单个用户可在管理后台单独设置 / 追加
# DEFAULT_QUOTA_MB=256

# 游客数据保留天数（游客账号及其库、文件在此天数后回收）
# GUEST_TTL_DAYS=7

# 登录态保留天数（注册用户）
# SESSION_TTL_DAYS=30

# 每 IP 每分钟请求数上限（机房共用出口 IP 时调高）
# RATE_LIMIT_PER_MIN=600
