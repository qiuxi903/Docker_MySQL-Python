# ========= 复制为 .env 后按需修改（docker compose 会自动读取）=========

# 网站对外端口
WEB_PORT=8000

# MySQL root 密码（仅容器内部使用，请修改）
MYSQL_ROOT_PASSWORD=change-me-root

# 管理员账号（登录网站后可管理用户）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 沙箱服务内部令牌（随机字符串即可，请修改）
RUNNER_TOKEN=change-me-runner-token

# Python 版本：3.12 或 3.14
PYTHON_VERSION=3.12

# 基础镜像源（国内拉不动 docker.io 时取消注释）：
# PYTHON_IMAGE=docker.m.daocloud.io/library/python
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:5.7

# 放在宝塔/Nginx 反向代理后面时设为 1（限流按真实学生 IP 计算）
# TRUST_PROXY=1
